[Unit]
Description=Backup de media da Plataforma de Justiça Climática
After=local-fs.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/justica-climatica/app
ExecStart=/usr/bin/bash /srv/justica-climatica/ops/backup-media.sh
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/srv/justica-climatica/media
ReadWritePaths=/srv/justica-climatica/backups
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
